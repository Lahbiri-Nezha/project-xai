# Normalisation des fins de ligne (stockage LF, indep du systeme)
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.ico binary
*.png binary
*.svg binary
Dockerfile text eol=lf
