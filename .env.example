# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sales_insight"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here-change-in-production"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Inngest
INNGEST_DEV=1
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Rétention réglementaire — durée de rétention des données (défaut 36 mois).
# RETENTION_MONTHS="36"

# Export CSV vers un stockage objet S3/MinIO (optionnel)
# Sans S3_ENABLED=true, les exports CSV restent générés en local (stream Blob).
S3_ENABLED="false"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="sales-insight-exports"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Force le style de chemin (obligatoire pour MinIO)
S3_FORCE_PATH_STYLE="true"
# URL publique de base si les objets sont accessibles via un CDN/bucket public,
# sinon l'URL est déduite de S3_ENDPOINT + S3_BUCKET.
# S3_PUBLIC_BASE_URL="https://cdn.example.com"

# OpenTelemetry (optionnel) — spans des fonctions Inngest vers un APM.
# Sans endpoint, le tracing est inactif (les métriques structurées stdout restent).
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME="sales-insight"
